{
  "id": "light",
  "name": "Headway Daylight (light)",
  "summary": "A light ground with a DARK-CASED street network. Authored to the same measured bar as the dark style, not left at the vendor default: the stock light basemap paints white roads on a near-white ground with a #e0e0e0 casing that measures 1.01:1 against the earth — the street edge is, by measurement, not there. Here the casing carries the street: a deep warm grey outline on every road class, place and street names pushed to near-black over a white halo, and water darkened until it separates from the land. Every ratio below is checked by test.",
  "labelHalo": {
    "width": 1.6,
    "blur": 0.4
  },
  "roadWidthScale": 1.0,
  "contrastTargets": {
    "road": 3.0,
    "label": 4.5,
    "water": 3.0
  },
