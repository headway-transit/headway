{
  "id": "dark",
  "name": "Headway Control Room (dark)",
  "summary": "A dark GROUND with a LIGHT street network. Authored — not filtered from the light style — because the partner agency's ITS manager reported that a dark theme buried the streets: the stock dark basemap paints roads dark grey on a dark ground (measured 1.5:1) so the network you are reasoning about disappears. This style inverts that: near-black warm ground, roads by class as light hairlines, water raised in contrast, and a halo under every label. Every ratio below is checked by test; the style does not ship if a street stops reading.",
  "labelHalo": {
    "width": 1.6,
    "blur": 0.4
  },
  "roadWidthScale": 1.15,
  "contrastTargets": {
    "road": 3.0,
    "label": 4.5,
    "water": 3.0
  },
  "contrastChecks": [
    {
      "what": "Motorway / highway vs ground",
      "kind": "road",
      "min": 3.0,
      "bg": "earth",
      "fg": ["highway", "highway_casing_early"]
    },
