# Headway single-box stack — environment template.
#
#   cp .env.example .env    # then edit .env; NEVER commit .env
#
# NO value in this file is a real secret, and no real secret may ever be
# committed here or in compose.yaml. Real secrets are injected at runtime via
# the mechanism the Security Engineer owns (see security/); the placeholders
# below exist so the stack fails loudly instead of booting with baked-in
# credentials. Passwords are intentionally BLANK: compose.yaml refuses to
# start until you set them.

# --- TimescaleDB (PostgreSQL 16 + TimescaleDB) -------------------------------
# One database per agency (ADR-0004); this is the single-box agency database.
POSTGRES_DB=headway
POSTGRES_USER=headway
# REQUIRED. Generate one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- MinIO (S3-compatible object store) --------------------------------------
MINIO_ROOT_USER=headway
# REQUIRED. Generate one, e.g.: openssl rand -base64 24
MINIO_ROOT_PASSWORD=
# Bucket the ingestion service writes raw payload objects into.
S3_BUCKET=headway-raw

# --- Ingestion connector feeds (profile `app`; walking skeleton, ADR-0009) ----
# Point these at any agency's public GTFS/GTFS-RT feeds to see the pipeline
# run. Leave blank until your agency's feed is known.
GTFS_STATIC_URL=
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_ALERTS_URL=
POLL_INTERVAL=30s
AGENCY_ID=

# --- API backend (profile `app`) -----------------------------------------------
# REQUIRED. Session-token signing secret; the API refuses to start without it.
# Generate one, e.g.: openssl rand -base64 32
HEADWAY_SESSION_SECRET=
# REQUIRED for certification. The installation's Ed25519 certification
# signing key: exactly 64 hex characters (a 32-byte seed). Generate one:
# openssl rand -hex 32
# This key signs every certification (tamper-evident certificate,
# handoff 0019). It lives ONLY here (or a secret file via
# HEADWAY_SIGNING_KEY_FILE) — never in the database, never in the repo.
# Rotating it changes the key fingerprint: certificates signed by the old
# key then verify as "key_mismatch" (honest, not tampering) — keep the old
# key if you need to re-verify old certificates.
HEADWAY_SIGNING_KEY=

# --- App image versions (updates; see docs/updating.md) ------------------------
# Which Headway app images run (ingestion, transform, api):
#   local          = built from this source tree on this computer (default)
#   vX.Y.Z[-suffix]= the signed release images published to ghcr.io
# Managed by ./install/install.sh --upgrade, which verifies every image's
# signature with cosign BEFORE pulling and only then changes this line.
# Editing it by hand skips that verification — don't, unless you know why.
# NOTE: with a release tag set here, never run `docker compose up --build`
# (it would overwrite the verified images with local builds wearing the
# release's name). The website (web) is always built locally because its
# API address is baked in at build time — see docs/updating.md.
HEADWAY_IMAGE_TAG=local
# Written by --upgrade before it switches versions, so you always know what
# to go back to. App images only: database changes are forward-only.
HEADWAY_PREVIOUS_IMAGE_TAG=

# --- Web frontend (profile `app`) ----------------------------------------------
# API origin baked into the JS bundle at BUILD time (Vite limitation —
# changing it requires `docker compose build web`). The default matches the
# api service's host port mapping. In lan mode the installer sets this to
# https://<HEADWAY_LAN_ADDRESS>/api and rebuilds web (see "Network access"
# below).
VITE_API_BASE_URL=http://localhost:8000

# --- Network access (profile `lan`) --------------------------------------------
# These four lines answer the installer question "Where will people use
# Headway from?" and are managed together by ./install/install.sh (or
# ./install/install.sh --reconfigure-access to change your answer later).
# Edit by hand only if you know why; docs/network-access.md explains all of it.
#
# HEADWAY_ACCESS_MODE: local = just this computer (default) | lan = other
# computers in the office, via the `lan` profile's Caddy doorway | it = IT
# staff manage access their own way (behaves like local on this box).
HEADWAY_ACCESS_MODE=local
# lan mode only: this computer's office-network address (IP or name) —
# Caddy serves https://<this address>. The installer detects and confirms
# it; it is never guessed silently. Blank otherwise.
HEADWAY_LAN_ADDRESS=
# Browser origins allowed to call the API cross-origin (comma-separated).
# lan mode keeps web + API under ONE https origin behind Caddy, so this is
# belt-and-suspenders kept in lockstep with HEADWAY_LAN_ADDRESS by the
# installer (wave-14 lesson: origin wiring is owned by tooling, not memory).
HEADWAY_CORS_ORIGINS=
# Whose "X-Forwarded-For" the API believes, comma-separated (addresses or
# CIDR blocks). Leave BLANK to use the compose default (Docker's private
# range), which is what lan mode needs: without it every request arrives as
# Caddy's own address, so the whole office shares one rate limit and every
# audit row records the doorway instead of the person. Set 127.0.0.1 as well
# if you run your own proxy on this computer instead of Caddy. A value that
# is not an address or CIDR stops the API from starting — a typo here would
# look exactly like it was working.
HEADWAY_TRUSTED_PROXIES=
# How many requests one SIGNED-IN ACCOUNT may make per minute (blank = 600),
# and how many evidence bundles specifically (blank = 10; one bundle can cost
# 142 MB and several seconds). 0 closes the surface entirely. Raise the first
# only if a real person meets it while working.
HEADWAY_HUMAN_REQUESTS_PER_MINUTE=
HEADWAY_EVIDENCE_BUNDLE_REQUESTS_PER_MINUTE=
# Compose profiles activated on plain `docker compose up` (installer-managed;
# lan mode sets app,lan so the web app and the doorway run together).
COMPOSE_PROFILES=

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# REQUIRED. Generate one, e.g.: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# --- Keycloak (optional profile `sso-broker`, ADR-0011) ------------------------
# Only needed if you enable the commented keycloak service in compose.yaml
# (SAML-only IdPs or IdP aggregation). The default stack does not run it.
#KEYCLOAK_ADMIN_USER=admin
#KEYCLOAK_ADMIN_PASSWORD=
# Source label for TIDES drops: tides_simulated (safe default) marks data as
# test/simulated on every figure it touches; set to "tides" ONLY for real data.
TIDES_SOURCE=tides_simulated

# Native vendor exports (optional, OFF unless BOTH lines are set). Drop your
# vendor system's own export files (e.g. TripSpark Streets APC CSV) into
# deploy/compose/vendor-drop/ and Headway's adapter for that vendor turns
# them into passenger events with full lineage. VENDOR_SOURCE must be a
# registered adapter label — unregistered labels are refused, and synthetic
# test files must never be dropped under a real vendor label.
# VENDOR_DROP_DIR=/data/vendor-drop
# VENDOR_SOURCE=tripspark_streets

# --- Samsara vanpool telematics (optional, OFF unless SAMSARA_ENABLED=true) ----
# Connect a Samsara account's vehicle statistics (odometer + engine time) for
# vanpool vehicle-miles/hours. Request a LEAST-PRIVILEGE token: "Read Vehicle
# Statistics" scope only, restricted to your vanpool tag (see the connector
# README / the data-ask). The token is a SECRET — set it only here, never
# commit this file. SAMSARA_SERVICE_DAY_TZ has no default (fail-closed); set
# your agency's IANA zone. Restrict the poll to the vanpool with a tag id.
#SAMSARA_ENABLED=true
#SAMSARA_API_TOKEN=          # the read-only token from Samsara (secret)
#SAMSARA_SOURCE=samsara      # "samsara" for a real account; "samsara_simulated" for test data
#SAMSARA_SERVICE_DAY_TZ=America/Los_Angeles
#SAMSARA_TAG_IDS=            # the Samsara tag id for the vanpool fleet (restricts the poll)
#SAMSARA_BASE_URL=           # optional; default https://api.samsara.com (EU/CA accounts differ)
